# TikTok Downloader Pro - API Configuration

# RapidAPI Key (Optional - for premium reliability)
# Get your key from: https://rapidapi.com/
# Search for: "TikTok Download Without Watermark"
REACT_APP_RAPIDAPI_KEY=

# Backend API URL (already configured)
REACT_APP_API_URL=http://localhost:5000/api

# Instructions:
# 1. Go to https://rapidapi.com/
# 2. Sign up (free)
# 3. Subscribe to "TikTok Download Without Watermark" API
# 4. Copy your X-RapidAPI-Key
# 5. Paste it after REACT_APP_RAPIDAPI_KEY= above
# 6. Save this file
# 7. Restart: npm start
